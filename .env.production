# Production build defaults — PUBLIC values only, never a secret: every
# NEXT_PUBLIC_* ends up inlined in the browser bundle anyway. Vercel project
# environment variables override anything here; .env.local overrides it locally.
# The API is called through THIS origin (next.config.ts proxies /v1/* to
# API_UPSTREAM_URL) so better-auth's session cookie is first-party. Called
# cross-site, the cookie stays on the API host and sign-in never sticks (#18).
# One build serves every domain on the project, so this must be the domain
# people use: on any other domain the cookie lands on the wrong host.
NEXT_PUBLIC_API_URL=https://bobr.adventuraix.pl
API_UPSTREAM_URL=https://bobr-backend.adventuraix.pl
NEXT_PUBLIC_DASHBOARD_URL=https://bobr-dashboard.adventuraix.pl
NEXT_PUBLIC_SITE_URL=https://bobr.adventuraix.pl
NEXT_PUBLIC_IMAGE_HOST=https://img.bobr.207-180-195-37.sslip.io
HTTPS_ENABLED=true
