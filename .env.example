# BOBR frontend — copy to .env.local

# Where bobr_backend lives. The /v1 prefix is added by lib/api/client.ts, so
# this is the bare origin. A wrong value fails as an opaque CORS or network
# error in the browser with nothing in the server log.
NEXT_PUBLIC_API_URL=http://localhost:8003

# Server-only: the real API origin that next.config.ts proxies /v1/* to. The
# proxy is on only when this differs from NEXT_PUBLIC_API_URL's origin, so with
# both on localhost:8003 local dev calls the API directly, as before.
#
# In production NEXT_PUBLIC_API_URL is this app's OWN origin and this is the API
# (see .env.production). That keeps better-auth's session cookie first-party;
# called cross-site, sign-in succeeds and the next page is anonymous. Vercel
# builds refuse to run without it.
API_UPSTREAM_URL=http://localhost:8003

# Canonical public origin, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Where meal photographs are served FROM, when that is not the API itself.
#
# With imgproxy configured, the API hands out URLs on the IMGPROXY_HOST origin;
# with a bucket but no imgproxy, on the S3 public endpoint. Either way the
# browser is told to load an image from an origin this app's CSP has never heard
# of, and blocks it: the card draws an empty frame and the only evidence is a
# console violation. Set this to that origin in production.
#
# Leave it empty when the API serves the bytes itself (no bucket, or local
# development) -- NEXT_PUBLIC_API_URL already covers that case.
NEXT_PUBLIC_IMAGE_HOST=

# --- Deployment --------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://domain.com          (this app's own origin)
# API_UPSTREAM_URL=http://backend.domain.com
# NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.domain.com
# NEXT_PUBLIC_SITE_URL=http://domain.com
#
# NEXT_PUBLIC_* are inlined at BUILD time — changing one needs a rebuild, not a
# restart. HTTPS_ENABLED below is a plain var read at server start, so it can
# be flipped by restarting.
#
# Gates upgrade-insecure-requests and HSTS. Leave false on an http-only host:
# upgrade-insecure-requests rewrites every http:// request to https:// and
# breaks the whole page.
HTTPS_ENABLED=false
